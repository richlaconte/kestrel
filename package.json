{
  "name": "kestrel-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Kestrel: just React. Actually native. Nothing else to learn.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:host": "cd host && cargo build --release",
    "test": "npm test --workspaces --if-present && node --test \"scripts/docs/*.test.mjs\"",
    "docs": "node scripts/docs/build.mjs",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
